{
  "id": "repoqa_inline_local_001",
  "name": "RepoQA local inline smoke test",
  "output": "outputs/repoqa_inline_local_001",
  "dataset": {
    "root": "datasets/repoqa",
    "id": "ctxbench/repoqa",
    "version": "2024-06-23-local.1"
  },
  "scope": {
    "instances": ["python__demo__target_function__ctx1k"],
    "tasks": ["snf_retrieve_function"]
  },
  "models": {
    "gpt-mini": {
      "provider": "openai",
      "name": "gpt-5.4-mini"
    }
  },
  "factors": {
    "model": ["gpt-mini"],
    "strategy": ["inline"],
    "format": ["code"]
  },
  "params": {
    "temperature": 0,
    "max_output_tokens": 1024
  },
  "evaluation": {
    "enabled": false,
    "judges": []
  },
  "execution": {
    "repeats": 1
  },
  "trace": {
    "enabled": true,
    "writeFiles": true,
    "save_raw_response": true,
    "save_usage": true,
    "save_errors": true
  }
}
