{
  "schemaVersion": 1,
  "baseline": "../../baselines/repoqa-long64-v2/frozen.json",
  "configurations": [
    "inline-code-full",
    "local-mcp-default"
  ],
  "targets": [
    "java_002",
    "java_003",
    "py_002",
    "py_003",
    "rs_001",
    "rs_002",
    "ts_003",
    "ts_004"
  ],
  "seeds": [
    902
  ],
  "repeats": 1,
  "latencyLimitMs": 10000,
  "policies": {
    "mcp": {
      "type": "fixed",
      "configuration": "local-mcp-default"
    },
    "frozen": {
      "type": "router",
      "adaptive": false,
      "incumbentScope": "bin",
      "latencyQuantile": 0.9
    },
    "v1": {
      "type": "router",
      "adaptive": true
    },
    "v2": {
      "type": "router",
      "adaptive": true,
      "estimator": "pooled-ratio",
      "incumbentScope": "bin",
      "latencyQuantile": 0.9,
      "switchOnObjectiveMiss": true,
      "cooldownRequests": 2,
      "updateWindow": 4,
      "minimumObservations": 2,
      "probeInterval": 10,
      "estimateTtlRequests": 12
    }
  },
  "scenarios": {
    "mcp-degraded": [
      {
        "kind": "delay",
        "configuration": "local-mcp-default",
        "scope": "tool-call",
        "delayMs": 2000,
        "firstRequest": 17,
        "lastRequest": 32
      }
    ]
  },
  "comparisons": [
    [
      "v2",
      "frozen"
    ]
  ]
}
