{
  "id": "datasets/repoqa",
  "name": "RepoQA experiment example",
  "output": "outputs",
  "dataset": {
    "id": "ctxbench/repoqa",
    "version": "2026-05-23",
    "root": "datasets/repoqa-example"
  },
  "models": {
    "gpt1": {
      "provider": "openai",
      "name": "gpt-5.4-nano"
    },
    "gpt2": {
      "provider": "openai",
      "name": "gpt-5.4-mini"
    },
    "gpt3": {
      "provider": "openai",
      "name": "gpt-6-luna"
    },
    "gemini1": {
      "provider": "google",
      "name": "gemini-2.5-flash-lite"
    },
    "gemini2": {
      "provider": "google",
      "name": "gemini-2.5-flash"
    }
  },
  "scope": {
    "instances": [],
    "tasks": ["snf_retrieve_function"]
  },
  "factors": {
    "model": ["gpt3"],
    "configuration": [
      "inline-code",
      "local-mcp-json",
      "local-mcp-lean",
      "local-function-lean"
    ]
  },
  "params": {
    "mcp_server": {
      "server_url": "https://llmctxbench-repoqa.fastmcp.app/mcp",
      "server_label": "ctxbench_repoqa",
      "server_description": "CTXBench RepoQA MCP server",
      "auth_token": "${REPOQA_MCP_TOKEN}"
    }
  },
  "evaluation": {
    "enabled": true
  },
  "trace": {
    "enabled": true,
    "writeFiles": true,
    "save_raw_response": true,
    "save_tool_calls": true,
    "save_usage": true,
    "save_errors": true
  },
  "execution": {
    "repeats": 1
  },
  "configurations": {
    "inline-code": {
      "strategy": "inline",
      "representation": "code",
      "surface": "full"
    },
    "local-function-json": {
      "strategy": "local_function",
      "representation": "json",
      "surface": "repoqa-default"
    },
    "local-mcp-json": {
      "strategy": "local_mcp",
      "representation": "json",
      "surface": "repoqa-default"
    },
    "local-mcp-lean": {
      "strategy": "local_mcp",
      "representation": "json",
      "surface": "repoqa-lean"
    },
    "local-function-lean": {
      "strategy": "local_function",
      "representation": "json",
      "surface": "repoqa-lean"
    }
  },
  "surfaces": {
    "full": { "type": "full_context" },
    "repoqa-default": {
      "type": "operations",
      "operations": ["list_files", "list_symbols", "get_symbol", "read_file"]
    },
    "repoqa-lean": {
      "type": "operations",
      "operations": [
        "list_files_lean",
        "list_symbols_lean",
        "get_symbol_lean",
        "read_file_lean"
      ]
    }
  }
}
