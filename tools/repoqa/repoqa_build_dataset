#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
default_python="$repo_root/tools/repoqa/.venv/bin/python"
python_bin="${REPOQA_PYTHON:-$default_python}"

setup_hint="cd tools/repoqa && uv sync --locked"

if [[ -d /nix/store ]]; then
  for candidate in /nix/store/*gcc-*-lib/lib /nix/store/*gfortran-*-lib/lib; do
    if [[ -e "$candidate/libstdc++.so.6" ]]; then
      export LD_LIBRARY_PATH="$candidate${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      break
    fi
  done
fi

if [[ ! -x "$python_bin" ]]; then
  {
    echo "RepoQA Python environment is missing or not executable: $python_bin"
    echo "Create the default tool environment with:"
    echo "  $setup_hint"
    echo "Or set REPOQA_PYTHON to a Python executable from a local RepoQA environment."
  } >&2
  exit 2
fi

if ! "$python_bin" -c 'import repoqa.search_needle_function; import repoqa.compute_score' >/dev/null 2>&1; then
  {
    echo "RepoQA imports failed for: $python_bin"
    echo "Expected imports: repoqa.search_needle_function and repoqa.compute_score"
    echo "Create or refresh the default tool environment with:"
    echo "  $setup_hint"
    echo "Or set REPOQA_PYTHON to a Python executable from a local RepoQA environment."
  } >&2
  exit 2
fi

exec "$python_bin" "$repo_root/tools/repoqa/build_repoqa_dataset.py" "$@"
