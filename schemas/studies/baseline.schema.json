{
  "$defs": {
    "InstanceSplit": {
      "additionalProperties": false,
      "description": "Explicit instance lists (JSON files relative to the definition).\n\nCalibration entries are instance IDs or {\"instance\": ID, \"weight\": w}; weights make the frozen\nestimates weighted means (for strata sampled away from their natural shares). A target's\ninstances must all fall on one side.",
      "properties": {
        "calibrationInstances": {
          "title": "Calibrationinstances",
          "type": "string"
        },
        "evaluationInstances": {
          "title": "Evaluationinstances",
          "type": "string"
        }
      },
      "required": [
        "calibrationInstances",
        "evaluationInstances"
      ],
      "title": "InstanceSplit",
      "type": "object"
    },
    "Split": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "calibrationTargetsPerLanguage": {
          "exclusiveMinimum": 0,
          "title": "Calibrationtargetsperlanguage",
          "type": "integer"
        }
      },
      "required": [
        "seed",
        "calibrationTargetsPerLanguage"
      ],
      "title": "Split",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "experiment": {
      "title": "Experiment",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "$ref": "#/$defs/Split"
        },
        {
          "$ref": "#/$defs/InstanceSplit"
        }
      ],
      "title": "Split"
    },
    "sizeProfile": {
      "anyOf": [
        {
          "enum": [
            "standard",
            "long64"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sizeprofile"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "repeats": {
      "exclusiveMinimum": 0,
      "title": "Repeats",
      "type": "integer"
    },
    "contextLimit": {
      "exclusiveMinimum": 0,
      "title": "Contextlimit",
      "type": "integer"
    },
    "outputReservation": {
      "exclusiveMinimum": 0,
      "title": "Outputreservation",
      "type": "integer"
    }
  },
  "required": [
    "experiment",
    "split",
    "seeds",
    "repeats",
    "contextLimit",
    "outputReservation"
  ],
  "title": "Baseline",
  "type": "object"
}
