{
  "$defs": {
    "BlindRouterPolicy": {
      "additionalProperties": false,
      "description": "Router that never reads request features (size bin, size, target).\n\nIt keeps its incumbent while the incumbent's recent cost fits the objective (latency limit\nand the trailing token-rate budget), and leaves when it no longer fits. It returns to a\nfaster configuration only through a probe whose own observation fits.",
      "properties": {
        "type": {
          "const": "blind-router",
          "title": "Type",
          "type": "string"
        },
        "adaptive": {
          "title": "Adaptive",
          "type": "boolean"
        },
        "estimateWindow": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Estimatewindow",
          "type": "integer"
        },
        "probeTriggers": {
          "items": {
            "enum": [
              "periodic",
              "signal"
            ],
            "type": "string"
          },
          "title": "Probetriggers",
          "type": "array"
        },
        "probeInterval": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Probeinterval",
          "type": "integer"
        },
        "probeBackoff": {
          "default": false,
          "title": "Probebackoff",
          "type": "boolean"
        },
        "signalWindow": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Signalwindow",
          "type": "integer"
        },
        "signalTokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signaltokens"
        },
        "budgetGuard": {
          "default": false,
          "title": "Budgetguard",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "adaptive"
      ],
      "title": "BlindRouterPolicy",
      "type": "object"
    },
    "BudgetOracle": {
      "additionalProperties": false,
      "description": "Derived after collection: per request, the sequence that knows every outcome in advance and\nminimises budget excess, then deadline misses, then total latency (exact search over the window).",
      "properties": {
        "type": {
          "const": "budget-oracle",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BudgetOracle",
      "type": "object"
    },
    "BudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "budget",
          "title": "Type",
          "type": "string"
        },
        "probeInterval": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Probeinterval",
          "type": "integer"
        },
        "unknownUsage": {
          "default": "stop",
          "enum": [
            "stop",
            "bounded"
          ],
          "title": "Unknownusage",
          "type": "string"
        },
        "forecast": {
          "default": "lookahead",
          "enum": [
            "lookahead",
            "expected"
          ],
          "title": "Forecast",
          "type": "string"
        },
        "mode": {
          "default": "incumbent",
          "enum": [
            "incumbent",
            "pace"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BudgetPolicy",
      "type": "object"
    },
    "CascadePolicy": {
      "additionalProperties": false,
      "description": "Primary configuration with a bounded within-request fallback on observed failures.",
      "properties": {
        "type": {
          "const": "cascade",
          "title": "Type",
          "type": "string"
        },
        "primary": {
          "title": "Primary",
          "type": "string"
        },
        "fallbacks": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Fallbacks",
          "type": "array"
        },
        "triggerFailureClasses": {
          "items": {
            "enum": [
              "operation",
              "transport",
              "provider",
              "tool-use",
              "step-limit",
              "unknown"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Triggerfailureclasses",
          "type": "array"
        },
        "primaryMaxSteps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primarymaxsteps"
        },
        "memory": {
          "default": "none",
          "enum": [
            "none",
            "source"
          ],
          "title": "Memory",
          "type": "string"
        }
      },
      "required": [
        "type",
        "primary",
        "fallbacks"
      ],
      "title": "CascadePolicy",
      "type": "object"
    },
    "Delay": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "delay",
          "default": "delay",
          "title": "Kind",
          "type": "string"
        },
        "configuration": {
          "title": "Configuration",
          "type": "string"
        },
        "scope": {
          "enum": [
            "request",
            "tool-call"
          ],
          "title": "Scope",
          "type": "string"
        },
        "delayMs": {
          "exclusiveMinimum": 0,
          "title": "Delayms",
          "type": "integer"
        },
        "firstRequest": {
          "exclusiveMinimum": 0,
          "title": "Firstrequest",
          "type": "integer"
        },
        "lastRequest": {
          "exclusiveMinimum": 0,
          "title": "Lastrequest",
          "type": "integer"
        }
      },
      "required": [
        "configuration",
        "scope",
        "delayMs",
        "firstRequest",
        "lastRequest"
      ],
      "title": "Delay",
      "type": "object"
    },
    "Fault": {
      "additionalProperties": false,
      "description": "Each local-MCP tool call fails with this probability (seeded per request position and call).",
      "properties": {
        "firstRequest": {
          "exclusiveMinimum": 0,
          "title": "Firstrequest",
          "type": "integer"
        },
        "lastRequest": {
          "exclusiveMinimum": 0,
          "title": "Lastrequest",
          "type": "integer"
        },
        "kind": {
          "const": "fault",
          "title": "Kind",
          "type": "string"
        },
        "configuration": {
          "title": "Configuration",
          "type": "string"
        },
        "toolErrorRate": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Toolerrorrate",
          "type": "number"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "firstRequest",
        "lastRequest",
        "kind",
        "configuration",
        "toolErrorRate",
        "seed"
      ],
      "title": "Fault",
      "type": "object"
    },
    "FixedPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fixed",
          "title": "Type",
          "type": "string"
        },
        "configuration": {
          "title": "Configuration",
          "type": "string"
        }
      },
      "required": [
        "type",
        "configuration"
      ],
      "title": "FixedPolicy",
      "type": "object"
    },
    "OrderPhase": {
      "additionalProperties": false,
      "description": "Positions up to `lastRequest` take, in seeded random order, unused requests of these sizes.",
      "properties": {
        "lastRequest": {
          "exclusiveMinimum": 0,
          "title": "Lastrequest",
          "type": "integer"
        },
        "sizes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sizes",
          "type": "array"
        },
        "disturbance": {
          "default": false,
          "title": "Disturbance",
          "type": "boolean"
        }
      },
      "required": [
        "lastRequest",
        "sizes"
      ],
      "title": "OrderPhase",
      "type": "object"
    },
    "PhaseOracle": {
      "additionalProperties": false,
      "description": "Derived after collection: `disturbance` in workload disturbance phases, `normal` elsewhere.",
      "properties": {
        "type": {
          "const": "phase-oracle",
          "title": "Type",
          "type": "string"
        },
        "normal": {
          "title": "Normal",
          "type": "string"
        },
        "disturbance": {
          "title": "Disturbance",
          "type": "string"
        }
      },
      "required": [
        "type",
        "normal",
        "disturbance"
      ],
      "title": "PhaseOracle",
      "type": "object"
    },
    "RandomPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "random-eligible",
          "title": "Type",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "seed"
      ],
      "title": "RandomPolicy",
      "type": "object"
    },
    "ReliabilityPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reliability",
          "title": "Type",
          "type": "string"
        },
        "failureClasses": {
          "items": {
            "enum": [
              "operation",
              "transport",
              "provider",
              "tool-use",
              "step-limit",
              "unknown"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Failureclasses",
          "type": "array"
        },
        "window": {
          "exclusiveMinimum": 0,
          "title": "Window",
          "type": "integer"
        },
        "minimumObservations": {
          "exclusiveMinimum": 0,
          "title": "Minimumobservations",
          "type": "integer"
        },
        "failureRateThreshold": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Failureratethreshold",
          "type": "number"
        },
        "cooldownRequests": {
          "exclusiveMinimum": 0,
          "title": "Cooldownrequests",
          "type": "integer"
        },
        "probeInterval": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Probeinterval",
          "type": "integer"
        },
        "resetOnRecovery": {
          "default": false,
          "title": "Resetonrecovery",
          "type": "boolean"
        },
        "incumbentScope": {
          "default": "global",
          "enum": [
            "global",
            "bin"
          ],
          "title": "Incumbentscope",
          "type": "string"
        }
      },
      "required": [
        "type",
        "failureClasses",
        "window",
        "minimumObservations",
        "failureRateThreshold",
        "cooldownRequests"
      ],
      "title": "ReliabilityPolicy",
      "type": "object"
    },
    "RouterPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "router",
          "title": "Type",
          "type": "string"
        },
        "adaptive": {
          "title": "Adaptive",
          "type": "boolean"
        },
        "probeInterval": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Probeinterval",
          "type": "integer"
        },
        "cooldownRequests": {
          "default": 5,
          "minimum": 0,
          "title": "Cooldownrequests",
          "type": "integer"
        },
        "updateWindow": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Updatewindow",
          "type": "integer"
        },
        "materialImprovement": {
          "default": 0.1,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Materialimprovement",
          "type": "number"
        },
        "incumbentScope": {
          "default": "global",
          "enum": [
            "global",
            "bin"
          ],
          "title": "Incumbentscope",
          "type": "string"
        },
        "estimator": {
          "default": "per-bin-mean",
          "enum": [
            "per-bin-mean",
            "pooled-ratio"
          ],
          "title": "Estimator",
          "type": "string"
        },
        "minimumObservations": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Minimumobservations",
          "type": "integer"
        },
        "estimateTtlRequests": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatettlrequests"
        },
        "probeMode": {
          "default": "round-robin",
          "enum": [
            "round-robin",
            "targeted"
          ],
          "title": "Probemode",
          "type": "string"
        },
        "avoidedProbeInterval": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avoidedprobeinterval"
        },
        "latencyQuantile": {
          "anyOf": [
            {
              "enum": [
                0.5,
                0.75,
                0.9,
                0.95
              ],
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latencyquantile"
        },
        "switchOnObjectiveMiss": {
          "default": false,
          "title": "Switchonobjectivemiss",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "adaptive"
      ],
      "title": "RouterPolicy",
      "type": "object"
    },
    "SchedulePhase": {
      "additionalProperties": false,
      "properties": {
        "firstRequest": {
          "exclusiveMinimum": 0,
          "title": "Firstrequest",
          "type": "integer"
        },
        "lastRequest": {
          "exclusiveMinimum": 0,
          "title": "Lastrequest",
          "type": "integer"
        },
        "configurationBySize": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Configurationbysize",
          "type": "object"
        }
      },
      "required": [
        "firstRequest",
        "lastRequest",
        "configurationBySize"
      ],
      "title": "SchedulePhase",
      "type": "object"
    },
    "SchedulePolicy": {
      "additionalProperties": false,
      "description": "Phase oracle: knows the disturbance schedule by design; an upper bound, not deployable.",
      "properties": {
        "type": {
          "const": "schedule",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Default"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/SchedulePhase"
          },
          "title": "Phases",
          "type": "array"
        }
      },
      "required": [
        "type",
        "default"
      ],
      "title": "SchedulePolicy",
      "type": "object"
    },
    "TokenQuota": {
      "additionalProperties": false,
      "description": "Harness-simulated provider quota over the trailing 60 s of wall time, for every configuration.",
      "properties": {
        "firstRequest": {
          "exclusiveMinimum": 0,
          "title": "Firstrequest",
          "type": "integer"
        },
        "lastRequest": {
          "exclusiveMinimum": 0,
          "title": "Lastrequest",
          "type": "integer"
        },
        "kind": {
          "const": "token-quota",
          "title": "Kind",
          "type": "string"
        },
        "tokensPerMinute": {
          "exclusiveMinimum": 0,
          "title": "Tokensperminute",
          "type": "integer"
        }
      },
      "required": [
        "firstRequest",
        "lastRequest",
        "kind",
        "tokensPerMinute"
      ],
      "title": "TokenQuota",
      "type": "object"
    },
    "TokenRateBudget": {
      "additionalProperties": false,
      "description": "Mean tokens per request over the trailing `window` served requests must stay within `perRequest`.",
      "properties": {
        "perRequest": {
          "exclusiveMinimum": 0,
          "title": "Perrequest",
          "type": "integer"
        },
        "window": {
          "exclusiveMinimum": 0,
          "title": "Window",
          "type": "integer"
        }
      },
      "required": [
        "perRequest",
        "window"
      ],
      "title": "TokenRateBudget",
      "type": "object"
    },
    "WorkloadOrder": {
      "additionalProperties": false,
      "description": "A reordering of the study's requests: every request appears exactly once.\n\n`sizes` are size bins (`small`, `medium`, `large`) or nominal sizes (`2k` ... `64k`).",
      "properties": {
        "phases": {
          "items": {
            "$ref": "#/$defs/OrderPhase"
          },
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        }
      },
      "required": [
        "phases"
      ],
      "title": "WorkloadOrder",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "baseline": {
      "title": "Baseline",
      "type": "string"
    },
    "configurations": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configurations"
    },
    "targets": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targets"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "repeats": {
      "exclusiveMinimum": 0,
      "title": "Repeats",
      "type": "integer"
    },
    "policies": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "blind-router": "#/$defs/BlindRouterPolicy",
            "budget": "#/$defs/BudgetPolicy",
            "cascade": "#/$defs/CascadePolicy",
            "fixed": "#/$defs/FixedPolicy",
            "random-eligible": "#/$defs/RandomPolicy",
            "reliability": "#/$defs/ReliabilityPolicy",
            "router": "#/$defs/RouterPolicy",
            "schedule": "#/$defs/SchedulePolicy"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FixedPolicy"
          },
          {
            "$ref": "#/$defs/RouterPolicy"
          },
          {
            "$ref": "#/$defs/BudgetPolicy"
          },
          {
            "$ref": "#/$defs/ReliabilityPolicy"
          },
          {
            "$ref": "#/$defs/CascadePolicy"
          },
          {
            "$ref": "#/$defs/SchedulePolicy"
          },
          {
            "$ref": "#/$defs/RandomPolicy"
          },
          {
            "$ref": "#/$defs/BlindRouterPolicy"
          }
        ]
      },
      "minProperties": 1,
      "title": "Policies",
      "type": "object"
    },
    "scenarios": {
      "additionalProperties": {
        "items": {
          "oneOf": [
            {
              "$ref": "#/$defs/Delay"
            },
            {
              "$ref": "#/$defs/Fault"
            },
            {
              "$ref": "#/$defs/TokenQuota"
            }
          ]
        },
        "type": "array"
      },
      "minProperties": 1,
      "title": "Scenarios",
      "type": "object"
    },
    "comparisons": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "latencyLimitMs": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latencylimitms"
    },
    "tokenBudget": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokenbudget"
    },
    "tokenRateBudget": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenRateBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workloads": {
      "additionalProperties": {
        "$ref": "#/$defs/WorkloadOrder"
      },
      "title": "Workloads",
      "type": "object"
    },
    "derivedArms": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "budget-oracle": "#/$defs/BudgetOracle",
            "phase-oracle": "#/$defs/PhaseOracle",
            "schedule": "#/$defs/SchedulePolicy"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SchedulePolicy"
          },
          {
            "$ref": "#/$defs/PhaseOracle"
          },
          {
            "$ref": "#/$defs/BudgetOracle"
          }
        ]
      },
      "title": "Derivedarms",
      "type": "object"
    },
    "minimumCalibrationPassRate": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimumcalibrationpassrate"
    }
  },
  "required": [
    "baseline",
    "seeds",
    "repeats",
    "policies",
    "scenarios"
  ],
  "title": "Study",
  "type": "object"
}
