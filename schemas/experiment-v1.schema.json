{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "dataset",
    "models",
    "configurations",
    "surfaces",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "enum": [
        "benchmark",
        "adaptive"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "dataset": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "scope": {
      "type": "object"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "name"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "modelParams": {
            "type": "object"
          }
        }
      }
    },
    "configurations": {
      "type": "object",
      "minProperties": 1
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskParams": {
      "type": "object"
    },
    "modelParams": {
      "type": "object"
    },
    "factorsMetadata": {
      "type": "object"
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "workload"
      ],
      "properties": {
        "policy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "candidate"
              ],
              "properties": {
                "type": {
                  "const": "static"
                },
                "candidate": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "latencyTargetMs"
              ],
              "properties": {
                "type": {
                  "const": "threshold"
                },
                "latencyTargetMs": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "candidate"
              ],
              "properties": {
                "type": {
                  "const": "cascade"
                },
                "candidate": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fallbacks": {
                  "type": "array",
                  "maxItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minimumResponseLength": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "candidate",
                "fallbacks"
              ],
              "properties": {
                "type": {
                  "const": "circuit_breaker"
                },
                "candidate": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fallbacks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "window": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimumObservations": {
                  "type": "integer",
                  "minimum": 1
                },
                "failureRateThreshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "latencyWeight",
                "tokenWeight"
              ],
              "properties": {
                "type": {
                  "const": "utility"
                },
                "latencyWeight": {
                  "type": "number",
                  "minimum": 0
                },
                "tokenWeight": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "tokenBudget"
              ],
              "properties": {
                "type": {
                  "const": "budget"
                },
                "tokenBudget": {
                  "type": "integer",
                  "minimum": 0
                },
                "bestEffort": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "seed",
                "explorationProbability",
                "latencyWeight",
                "tokenWeight"
              ],
              "properties": {
                "type": {
                  "const": "explore"
                },
                "seed": {
                  "type": "integer"
                },
                "explorationProbability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "latencyWeight": {
                  "type": "number",
                  "minimum": 0
                },
                "tokenWeight": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "tokenQuota": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokens",
            "windowSeconds"
          ],
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "bestEffort": {
              "type": "boolean"
            }
          }
        },
        "calibration": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "instanceId"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "sizeBin": {
                "enum": [
                  "small",
                  "medium",
                  "large"
                ]
              },
              "eligibleCandidates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "firstRequest",
              "lastRequest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "firstRequest": {
                "type": "integer",
                "minimum": 1
              },
              "lastRequest": {
                "type": "integer",
                "minimum": 1
              },
              "toolDelayMs": {
                "type": "integer",
                "minimum": 0
              },
              "toolFailureRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "failureSeed": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "string"
        },
        "jsonl": {
          "type": "string"
        },
        "options": {
          "type": "object"
        }
      }
    },
    "evaluation": {
      "type": "object"
    },
    "trace": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    }
  }
}
